/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* Variable declarations */
  char buf[16];      // Changed from unsigned char to char to fix sprintf warning
  unsigned int val;
  float final;

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* Configure the system clock */
  SystemClock_Config();

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_ADC1_Init();

  /* Initialize LCD */
  lcd_init();
  lcd_clear();

  /* USER CODE BEGIN WHILE */
  while (1)
  {
      // Display static header on Line 1
      lcd_displayString(1, 1, "ADC-PA3 pot-P3");

      // Start ADC Conversion
      HAL_ADC_Start(&hadc1);

      // Wait for conversion to complete (1ms timeout)
      if (HAL_ADC_PollForConversion(&hadc1, 1) == HAL_OK)
      {
          // Read raw value and scale to millivolts
          val = (unsigned int)HAL_ADC_GetValue(&hadc1);
          final = ((float)val) * 0.8f;
          val = (unsigned int)final;

          // Format value into string
          sprintf(buf, "%2u", val); // Using %u for unsigned int

          // Update LCD Line 2
          lcd_displayString(2, 1, "    "); // Clear old digits
          lcd_displayString(2, 1, buf);    // Display new value
          lcd_displayString(2, 7, "mv");   // Display unit
      }

      HAL_ADC_Stop(&hadc1);

      // Delay for 1 second before next reading
      HAL_Delay(1000);
  }
}

