#include "main.h"
#include "lcd.h"
#include <stdio.h>

/* Private variables ---------------------------------------------------------*/
ADC_HandleTypeDef hadc1;

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_ADC1_Init(void);
void Error_Handler(void);

/**
  * @brief  The application entry point.
  */
int main(void)
{
  unsigned char buf[16];
  unsigned int  val = 0;

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* Configure the system clock */
  SystemClock_Config();

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_ADC1_Init();

  /* USER CODE BEGIN 2 */
  lcd_init();
  lcd_clear();
  lcd_displayString(1, 1, "SYSTEM READY");
  HAL_Delay(1000);
  /* USER CODE END 2 */

  /* Infinite loop */
  while (1)
  {
    HAL_ADC_Start(&hadc1);

    if (HAL_ADC_PollForConversion(&hadc1, 10) == HAL_OK)
    {
        val = HAL_ADC_GetValue(&hadc1);

        lcd_clear();
        lcd_displayString(1, 1, "LDR SYSTEM");

        sprintf((char*)buf, "VALUE: %d", val);
        lcd_displayString(2, 1, (char*)buf);

        // Logic for LED on PC3 based on LDR value
        if(val < 1000)
        {
            HAL_GPIO_WritePin(GPIOC, GPIO_PIN_3, GPIO_PIN_SET);   // LED ON
            lcd_displayString(1, 12, "DARK");
        }
        else
        {
            HAL_GPIO_WritePin(GPIOC, GPIO_PIN_3, GPIO_PIN_RESET); // LED OFF
            lcd_displayString(1, 12, "BRIT");
        }
    }
    HAL_Delay(300);
  }
}

